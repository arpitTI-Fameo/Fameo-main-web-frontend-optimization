{
  "name": "fameo-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings=0",
    "lint:report": "eslint . -f json -o eslint-report.json || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run codemap && npm run lint:ci && npm run test && npm run build",
    "codemap": "node scripts/gen-codemap.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "isomorphic-dompurify": "^2.16.0",
    "jose": "^5.9.6",
    "lucide-react": "^1.0.1",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.88.0",
    "socket.io-client": "^4.8.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "globals": "^17.12.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "vitest": "^3.2.7"
  }
}
