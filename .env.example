# Local development. Production values are NOT kept in files:
#   NEXT_PUBLIC_* → GitHub repository variables (compiled in at build time)
#   everything else → AWS SSM Parameter Store, /fameo-web/production
# See DEPLOYMENT.md.

# fameo-web/.env.example

# ── Client variables (NEXT_PUBLIC_ prefix) ───────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
NEXT_PUBLIC_APP_NAME=Fameo
NEXT_PUBLIC_SITE_URL=https://fameo.vip
NEXT_PUBLIC_APP_ORIGIN=
NEXT_PUBLIC_PORTAL_MOCK=false

# ── Server variables (SERVER-ONLY — no NEXT_PUBLIC_ prefix) ──────────────────
API_ORIGIN=http://localhost:8000
APP_ORIGIN=http://localhost:5001

# Generate secure random strings for these in production
JWT_SECRET=
REVALIDATE_SECRET=

# Third-party integrations
SMARTAUTH_KEY=
SMARTAUTH_BASE=https://prod.smartauth.co

# Environment toggles
DEV_MODE=true
